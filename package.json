{
  "name": "eyelock-studio-news-microsite",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch": "ts-node --esm ./scripts/fetch-and-build.ts",
    "fetch-and-build": "npm run fetch && npm run build",
    "docker:build": "docker build -t fanbase-news:latest .",
    "docker:run": "docker run --rm -e PUBLIC_BACKEND_URL=\"$PUBLIC_BACKEND_URL\" -p 8080:8080 fanbase-news:latest"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.1",
    "astro": "^5.16.5",
    "dompurify": "^2.5.8",
    "jsdom": "^22.1.0",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^27.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.0"
  }
}
